# Copy to .env. This example is not a live secret or active deployment.
HOST_PORT=8766
DATA_PATH=/mnt/user/appdata/pokesurvivor-cn/data
# Empty for LAN testing; set the exact HTTPS origin before public use.
PUBLIC_ORIGIN=https://game.example.com
TRUST_PROXY=true
REGISTRATION=true
PUID=99
PGID=100

# Optional Cloudflare Realtime TURN; NAS brokers credentials, not gameplay.
# Secrets must stay on NAS. Use bash deploy/setup-cloudflare-turn.sh.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Conservative issuance guard, not Cloudflare's billing hard limit.
CF_TURN_CAP_GB=100
# Reserve for SFU or other shared Realtime free-tier usage.
CF_TURN_OTHER_USAGE_GB=0
